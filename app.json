{
  "expo": {
    "name": "TravelAssistant",
    "slug": "TravelAssistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "travelassistant",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.travelassistant.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TravelAssistant uses your location to show nearby places, directions, and emergency services when you ask.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "TravelAssistant can use location for transit reminders after you opt in."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B726A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.travelassistant.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "react-native-maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow TravelAssistant to use your location for nearby places and directions."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TravelAssistant uses your photos so you can share travel spot pictures with other travelers.",
          "cameraPermission": "TravelAssistant uses your camera so you can add photos of places you’ve visited.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0B726A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B726A"
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow TravelAssistant to use the microphone for voice travel questions.",
          "speechRecognitionPermission": "Allow TravelAssistant to turn your speech into travel questions."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
