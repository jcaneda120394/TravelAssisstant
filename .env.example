# TravelAssistant — public client environment variables
# Copy to `.env` and fill values. Never put secret API keys here.
# On Vercel, set the same EXPO_PUBLIC_* keys for Production + Preview (build-time).

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_NAME=TravelAssistant
# Optional overrides — defaults come from package.json / Vercel git SHA on deploy
# EXPO_PUBLIC_APP_VERSION=1.2.0
# EXPO_PUBLIC_APP_BUILD=

# Supabase project
# Dashboard: https://supabase.com/dashboard/project/<ref>/settings/api
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Provider mode — false = live free APIs (OSM, OSRM, Open-Meteo, Frankfurter)
EXPO_PUBLIC_USE_MOCK_PROVIDERS=false

# Optional analytics / crash (public keys only)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
EXPO_PUBLIC_SENTRY_DSN=

# Optional Google Maps / Places keys
# Preferred (server): set GOOGLE_MAPS_API_KEY on the Supabase `google-places` Edge Function
#   (Places API New enabled) — powers Search, Explore, Home, Map, trips, AI + photos.
# Optional client fallback (restrict by HTTP referrer / app package):
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Travel images (Pexels → Unsplash → Openverse → Wikimedia)
# NEVER put Pexels/Unsplash keys in EXPO_PUBLIC_* — they must stay server-side.
# Set Supabase Edge secrets for `stock-photos`:
#   npx supabase secrets set PEXELS_API_KEY=... UNSPLASH_ACCESS_KEY=... --project-ref <ref>
# Openverse + Wikimedia need no key (client + edge fallback).
# Apply place_images cache migration after pull.
