# TravelAssistant — public client environment variables
# Copy to `.env` and fill values. Never put secret API keys here.

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_NAME=TravelAssistant

# Supabase project: viyzvgdvnxhddtobpyys
# Dashboard: https://supabase.com/dashboard/project/viyzvgdvnxhddtobpyys/settings/general
EXPO_PUBLIC_SUPABASE_URL=https://viyzvgdvnxhddtobpyys.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Provider mode — keep true until real APIs are wired through Edge Functions
EXPO_PUBLIC_USE_MOCK_PROVIDERS=true

# Optional analytics / crash (public keys only)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
EXPO_PUBLIC_SENTRY_DSN=
